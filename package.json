{
  "name": "notention",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./core/dist/index.node.js",
    "./core": "./core/dist/index.node.js",
    "./agent": "./agent/dist/index.js",
    "./cli": "./cli/dist/index.js",
    "./optimize": "./optimize/dist/index.js",
    "./simulator": "./simulator/dist/index.js",
    "./eval": "./ui/eval/dist/index.js",
    "./conformance": "./packages/conformance/dist/index.js"
  },
  "workspaces": [
    "ui",
    "agent",
    "core",
    "cli",
    "simulator",
    "optimize",
    "ui/eval"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "pnpm --filter @notention/core test && pnpm --filter @notention/agent test && pnpm --filter @notention/cli test && pnpm --filter @notention/optimize test && pnpm --filter @notention/simulator test",
    "test:ui": "tsx scripts/test-ui-batched.ts",
    "verify": "tsx scripts/verify.ts",
    "lint:fabricated": "tsx scripts/grep-fabricated-paths.ts",
    "eval:update-manifest": "tsx scripts/update-case-manifest.ts",
    "eval:verify-manifest": "tsx -e \"import {verifyManifest} from '@notention/core/eval/caseManifest'; const v=verifyManifest(); console.log(v.valid?'✅ OK':'❌ '+v.error); if(!v.valid)process.exit(1)\"",
    "generate:definitions": "tsx scripts/generate-definitions.ts",
    "lint:schemas": "tsx scripts/lint-schemas.ts",
    "lint:contracts": "tsx scripts/lint-contracts.ts",
    "screenshots": "pnpm --filter @notention/ui screenshots",
    "test:e2e": "pnpm --filter @notention/ui test:e2e",
    "relay": "pnpm --filter @notention/agent relay --",
    "dev:demo": "node scripts/dev-demo.mjs",
    "ui:dev": "npm run dev -w @notention/ui",
    "ui:preview": "npm run preview -w @notention/ui",
    "agent": "npm start -w @notention/agent",
    "dev:local": "VITE_ENABLE_AGENT=false VITE_LLM_SOURCE=none npm run dev -w @notention/ui",
    "dev:server": "node scripts/dev-runner.js",
    "cli": "npm start -w @notention/cli --",
    "optimize": "tsx optimize/src/cli.ts",
    "optimize:check": "node scripts/check-optimize-locators.mjs",
    "loop": "tsx optimize/src/loop/cli.ts",
    "showcase": "tsx scripts/generate-showcases.ts",
    "stranger-test": "tsx scripts/stranger-test.ts",
    "match-relevance": "tsx scripts/match-relevance-test.ts",
    "preference-exp": "tsx scripts/run-preference-experiment.ts",
    "bench:plugins": "tsx scripts/bench-plugins.ts"
  },
  "dependencies": {
    "@meshtastic/core": "^2.6.7",
    "@meshtastic/transport-node-serial": "^0.0.2",
    "@meshtastic/transport-web-serial": "^0.2.5",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.1.0",
    "playwright": "^1.60.0",
    "uuid": "^9.0.1",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/inquirer": "^9.0.9",
    "@types/uuid": "^10.0.0",
    "boxen": "^8.0.1",
    "define-data-property": "^1.1.4",
    "esbuild": "^0.28.0",
    "estraverse": "^5.3.0",
    "has-property-descriptors": "^1.0.2",
    "pkg": "^5.8.1",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "vitest": "^4.1.6"
  }
}
