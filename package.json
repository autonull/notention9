{
  "name": "notention-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm run -r build",
    "test": "pnpm run --filter !@notention/ui test",
    "ui:dev": "pnpm run --filter @notention/ui dev",
    "ui:preview": "pnpm run --filter @notention/ui preview",
    "agent": "pnpm start --filter @notention/agent",
    "dev:local": "VITE_ENABLE_AGENT=false VITE_LLM_SOURCE=none pnpm run --filter @notention/ui dev",
    "dev:server": "node scripts/dev-runner.js",
    "cli": "pnpm start --filter @notention/cli --"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.48",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@tiptap/core": "^3.22.1",
    "ai": "^3.4.33",
    "chalk": "^4.1.2",
    "date-fns": "^4.1.0",
    "nostr-tools": "^2.23.3",
    "playwright": "^1.59.1",
    "uuid": "^9.0.1",
    "vitest": "^4.1.2",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/uuid": "^10.0.0",
    "define-data-property": "^1.1.4",
    "estraverse": "^5.3.0",
    "has-property-descriptors": "^1.0.2",
    "node-llama-cpp": "^3.15.1",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2"
  }
}
