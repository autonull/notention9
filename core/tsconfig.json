{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "composite": true,
    "declarationMap": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "src/ui", "src/types"],
  "exclude": ["src/tests"]
}