{
  "name": "@notention/cli",
  "version": "1.0.0",
  "type": "module",
  "description": "Agentic text UI for Notention",
  "main": "dist/index.js",
  "bin": {
    "notention": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/notention.cjs --format=cjs --external:fsevents --log-level=error --alias:@notention/core=../core/src/index.ts --alias:@notention/agent=../agent/src/index.ts --external:cosmiconfig --external:conf --external:dotenv --external:inquirer --external:ora --external:chalk --external:commander --external:ai --external:@ai-sdk/openai --external:eventsource --external:marked --external:marked-terminal --external:zod --external:nostr-tools --external:@modelcontextprotocol/sdk --external:@xenova/transformers --external:playwright --external:express --external:ws --external:boxen",
    "package": "npm run bundle && pkg -t node18-linux-x64 --out-path bin dist/notention.cjs",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.48",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@notention/agent": "workspace:*",
    "@notention/core": "workspace:*",
    "@types/conf": "^2.1.0",
    "@types/cosmiconfig": "^5.0.3",
    "@types/dotenv": "^6.1.1",
    "@types/inquirer": "^9.0.9",
    "@types/ora": "^3.1.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^3.0.0",
    "chalk": "^4.1.2",
    "commander": "^10.0.1",
    "conf": "^15.1.0",
    "cosmiconfig": "^9.0.0",
    "dotenv": "^16.4.5",
    "eventsource": "^2.0.2",
    "inquirer": "^13.2.2",
    "marked": "^4.3.0",
    "marked-terminal": "^7.3.0",
    "nostr-tools": "^2.23.1",
    "ora": "^9.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/marked": "^5.0.2",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "pkg": "^5.8.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  }
}
