{
  "name": "@notention/simulator",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./scenario": "./dist/scenario.js",
    "./agent": "./dist/agent.js",
    "./constants": "./dist/constants.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test:e2e": "playwright test -c src/tests/e2e/playwright.config.ts",
    "build": "tsc && npm run build:ui",
    "build:ui": "vite build --config vite.config.ts",
    "ui:dev": "vite dev --config vite.config.ts",
    "test": "NODE_OPTIONS='--no-warnings=ExperimentalWarning' vitest run --passWithNoTests"
  },
  "dependencies": {
    "@notention/core": "workspace:*",
    "@types/express": "^5.0.6",
    "chalk": "^6.0.0",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.575.0",
    "nostr-tools": "^2.26.0",
    "ora": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0",
    "vite": "^6.3.0"
  }
}
