    {
      "id": "template.help-system",
      "name": "Help System Template",
      "status": "implemented",
      "type": "capability",
      "summary": "Multi-panel layout with sidebar, content area, and video player",
      "seam": "render",
      "strategy": "help-system",
      "shape": "panel",
      "componentTemplate": "// GENERATED by UISG codegen - DO NOT EDIT MANUALLY\nimport { useHelp } from '@/hooks/useHelp';\nimport { HelpSidebar } from './HelpSidebar';\nimport { HelpTopicCard } from './HelpTopicCard';\nimport { HelpStepRenderer } from './HelpStepRenderer';\nimport { HelpVideoPlayer } from './HelpVideoPlayer';\nimport { HelpInteractiveDemo } from './HelpInteractiveDemo';\nimport { HelpSearch } from './HelpSearch';\nimport { HelpFeedback } from './HelpFeedback';\nimport { HelpProgressBar } from './HelpProgressBar';\n\nexport function {{componentName}}(props: {{componentName}}Props) {\n  const help = useHelp();\n  return (\n    <div className=\"help-system\" data-testid=\"help-system\">\n      <HelpSidebar />\n      <div className=\"help-content\">\n        <HelpSearch />\n        <HelpTopicCard topic={help.currentTopic} />\n        <HelpStepRenderer />\n        <HelpVideoPlayer />\n        <HelpInteractiveDemo />\n        <HelpProgressBar />\n        <HelpFeedback />\n      </div>\n    </div>\n  );\n}\n",
      "slots": [
        "sidebar",
        "content",
        "video-player",
        "progress-bar",
        "feedback"
      ]
    },
    {
      "id": "template.inline-promo",
      "name": "Inline Promo Template",
      "status": "implemented",
      "type": "capability",
      "summary": "Small promotional element embedded in content",
      "seam": "render",
      "strategy": "inline-promo",
      "shape": "status",
      "componentTemplate": "// GENERATED by UISG codegen - DO NOT EDIT MANUALLY\nimport { useDescribeItPromo } from '@/hooks/useDescribeItPromo';\n\nexport function {{componentName}}(props: {{componentName}}Props) {\n  const promo = useDescribeItPromo({ variant: props.variant });\n  if (!promo.shouldShow) return null;\n  return (\n    <div className=\"inline-promo\" data-testid=\"inline-promo-{{variant}}\">\n      <button onClick={promo.onDismiss} className=\"promo-dismiss\" aria-label=\"Dismiss\">×</button>\n      <span className=\"promo-content\">{promo.message}</span>\n      <button onClick={promo.onActivate} className=\"promo-cta\">{promo.ctaText}</button>\n    </div>\n  );\n}\n",
      "slots": [
        "trigger",
        "content",
        "dismiss"
      ]
    },
    {
      "id": "template.empty-state",
      "name": "Empty State Template",
      "status": "implemented",
      "type": "capability",
      "summary": "Actionable empty state with primary/secondary CTAs and help link",
      "seam": "render",
      "strategy": "empty-state",
      "shape": "status",
      "componentTemplate": "// GENERATED by UISG codegen - DO NOT EDIT MANUALLY\nimport { useHelp } from '@/hooks/useHelp';\n\nexport function {{componentName}}(props: {{componentName}}Props) {\n  const help = useHelp();\n  const config = EMPTY_STATE_CONFIGS[props.variant];\n  return (\n    <div className=\"empty-state\" data-testid=\"empty-state-{{variant}}\">\n      <div className=\"empty-illustration\">{config.illustration}</div>\n      <h2 className=\"empty-title\">{config.title}</h2>\n      <p className=\"empty-description\">{config.description}</p>\n      <div className=\"empty-actions\">\n        <button onClick={config.primaryAction} className=\"btn-primary\" data-testid=\"empty-primary-cta\">\n          {config.primaryLabel}\n        </button>\n        {config.secondaryLabel && (\n          <button onClick={config.secondaryAction} className=\"btn-secondary\" data-testid=\"empty-secondary-cta\">\n            {config.secondaryLabel}\n          </button>\n        )}\n      </div>\n      {config.helpTopicId && (\n        <button onClick={() => help.openTopic(config.helpTopicId)} className=\"help-link\" data-testid=\"empty-help-link\">\n          Learn more\n        </button>\n      )}\n    </div>\n  );\n}\n",
      "slots": [
        "illustration",
        "title",
        "description",
        "primary-action",
        "secondary-action",
        "help-link"
      ]
    },
    {
      "id": "template.modal-fullscreen",
      "name": "Modal Fullscreen Template",
      "status": "implemented",
      "type": "capability",
      "summary": "Full-screen modal for mobile with safe area handling",
      "seam": "render",
      "strategy": "modal-fullscreen",
      "shape": "panel",
      "componentTemplate": "// GENERATED by UISG codegen - DO NOT EDIT MANUALLY\nimport { useVirtualKeyboard } from '@/hooks/useVirtualKeyboard';\n\nexport function {{componentName}}(props: {{componentName}}Props) {\n  const { isKeyboardVisible, keyboardHeight } = useVirtualKeyboard();\n  return (\n    <div \n      className=\"modal-fullscreen\" \n      data-testid=\"modal-fullscreen\"\n      style={{ paddingBottom: isKeyboardVisible ? keyboardHeight : 0 }}\n    >\n      <div className=\"modal-header\">{props.children?.header}</div>\n      <div className=\"modal-content\">{props.children?.content}</div>\n      <div className=\"modal-footer\">{props.children?.footer}</div>\n      {isKeyboardVisible && <div className=\"keyboard-spacer\" style={{ height: keyboardHeight }} />}\n    </div>\n  );\n}\n",
      "slots": [
        "header",
        "content",
        "footer",
        "keyboard-spacer"
      ]
    },
    {
      "id": "template.bottom-sheet",
      "name": "Bottom Sheet Template",
      "status": "implemented",
      "type": "capability",
      "summary": "Swipeable bottom sheet with grabber and dismiss",
      "seam": "render",
      "strategy": "bottom-sheet",
      "shape": "panel",
      "componentTemplate": "// GENERATED by UISG codegen - DO NOT EDIT MANUALLY\nimport { useTouchGestures } from '@/hooks/useTouchGestures';\n\nexport function {{componentName}}(props: {{componentName}}Props) {\n  const { onSwipeDown } = useTouchGestures({ onSwipeDown: props.onDismiss });\n  return (\n    <div className=\"bottom-sheet\" data-testid=\"bottom-sheet\" onTouchMove={onSwipeDown}>\n      <div className=\"sheet-grabber\" aria-hidden=\"true\" />\n      <div className=\"sheet-content\">{props.children}</div>\n      <div className=\"sheet-actions\">{props.actions}</div>\n    </div>\n  );\n}\n",
      "slots": [
        "grabber",
        "content",
        "actions"
      ]
    },
    {
      "id": "template.bottom-tabs",
      "name": "Bottom Tabs Template",
      "status": "implemented",
      "type": "capability",
      "summary": "Horizontal scrolling tabs with snap points and 48px targets",
      "seam": "render",
      "strategy": "bottom-tabs",
      "shape": "item",
      "componentTemplate": "// GENERATED by UISG codegen - DO NOT EDIT MANUALLY\nimport { useMobile } from '@/hooks/useMobile';\n\nexport function {{componentName}}(props: {{componentName}}Props) {\n  const { isMobile } = useMobile();\n  if (!isMobile) return null;\n  return (\n    <div className=\"bottom-tabs\" data-testid=\"bottom-tabs\" role=\"tablist\">\n      <div className=\"tab-list\" role=\"presentation\">\n        {props.tabs.map((tab, i) => (\n          <button\n            key={tab.id}\n            role=\"tab\"\n            aria-selected={i === props.activeIndex}\n            className=\"tab-button\"\n            data-testid={`tab-${tab.id}`}\n            style={{ minWidth: 48, minHeight: 48 }}\n          >\n            {tab.label}\n          </button>\n        ))}\n      </div>\n      <div className=\"tab-panels\">\n        {props.tabs[props.activeIndex]?.panel}\n      </div>\n    </div>\n  );\n}\n",
      "slots": [
        "tab-list",
        "tab-panel"
      ]
    },
    {
      "id": "template.settings-wizard",
      "name": "Settings Wizard Template",
      "status": "implemented",
      "type": "capability",
      "summary": "Progressive disclosure settings with groups, search, export/import, diff",
      "seam": "render",
      "strategy": "settings-wizard",
      "shape": "panel",
      "componentTemplate": "// GENERATED by UISG codegen - DO NOT EDIT MANUALLY\nimport { useSettings } from '@/hooks/useSettings';\nimport { useHelp } from '@/hooks/useHelp';\n\nexport function {{componentName}}(props: {{componentName}}Props) {\n  const settings = useSettings();\n  const help = useHelp();\n  return (\n    <div className=\"settings-directory\" data-testid=\"settings-directory\">\n      <input \n        type=\"search\" \n        placeholder=\"Search settings…\" \n        value={settings.searchQuery}\n        onChange={settings.setSearchQuery}\n        data-testid=\"settings-search\"\n      />\n      <div className=\"settings-groups\">\n        {settings.groups.map(group => (\n          <details key={group.id} open={group.defaultExpanded} data-testid={`settings-group-${group.id}`}>\n            <summary>{group.label} <HelpIcon topic={group.helpTopicId} /></summary>\n            {group.settings.map(s => <SettingRow key={s.id} setting={s} />)}\n          </details>\n        ))}\n      </div>\n      {settings.showWizard && <SettingsWizard />}\n      <div className=\"settings-actions\">\n        <button onClick={settings.export} data-testid=\"settings-export\">Export</button>\n        <button onClick={settings.import} data-testid=\"settings-import\">Import</button>\n        <button onClick={settings.showDiff} data-testid=\"settings-diff\">Show Diff</button>\n      </div>\n    </div>\n  );\n}\n",
      "slots": [
        "search",
        "groups",
        "wizard-steps",
        "export-import",
        "diff-view"
      ]
    },
    {
      "id": "template.map-full",
      "name": "Full Screen Map Template",
      "status": "implemented",
      "type": "capability",
      "summary": "Full-screen map view with FAB in safe area",
      "seam": "render",
      "strategy": "map-full",
      "shape": "panel",
      "componentTemplate": "// GENERATED by UISG codegen - DO NOT EDIT MANUALLY\nimport { useMobile } from '@/hooks/useMobile';\n\nexport function {{componentName}}(props: {{componentName}}Props) {\n  const { safeAreaInsets } = useMobile();\n  return (\n    <div className=\"map-full\" data-testid=\"map-full\" style={{ paddingBottom: safeAreaInsets.bottom }}>\n      <div className=\"map-container\" ref={props.mapRef} />\n      <button className=\"fab fab-primary\" data-testid=\"map-fab\" style={{ bottom: safeAreaInsets.bottom + 16 }}>\n        {props.fabContent}\n      </button>\n      <button className=\"fab fab-geolocation\" data-testid=\"map-geolocation\" style={{ bottom: safeAreaInsets.bottom + 80 }}>\n        <GeolocationIcon />\n      </button>\n    </div>\n  );\n}\n",
      "slots": [
        "map",
        "fab",
        "geolocation",
        "safe-area-bottom"
      ]
    },
