FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY core/package.json ./core/
COPY agent/package.json ./agent/
COPY ui/package.json ./ui/
COPY cli/package.json ./cli/
COPY optimize/package.json ./optimize/
COPY simulator/package.json ./simulator/

# Install dependencies
RUN corepack enable pnpm && pnpm install --frozen-lockfile

# Copy source
COPY . .

# Build core package
RUN pnpm --filter @notention/core build

# Expose relay port
EXPOSE 7000

# Start local relay
CMD ["node", "-e", "
const { LocalRelay } = require('@notention/core/network/nostr/LocalRelay');
const relay = new LocalRelay({ port: 7000 });
relay.start().then(() => console.log('Local relay running on ws://0.0.0.0:7000'));
"]