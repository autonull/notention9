# Relay public keys (hex, 64 chars each)
# Generate with: pnpm cli relay generate
RELAY_1_PUBKEY=your_relay1_pubkey_here
RELAY_2_PUBKEY=your_relay2_pubkey_here
RELAY_3_PUBKEY=your_relay3_pubkey_here

# Contact information for NIP-11
RELAY_CONTACT=your@email.com

# Optional: NIP-42 auth required (true/false)
RELAY_AUTH_REQUIRED=false

# Optional: Relay software specific settings
RELAY_MAX_MESSAGE_LENGTH=16384
RELAY_MAX_SUBSCRIPTIONS=20
RELAY_MAX_FILTERS=100